# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요. .env.local 은 git에 올라가지 않습니다.

# LiveKit Cloud → 프로젝트 Settings → Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 브라우저에서 쓰는 주소 (LIVEKIT_URL 과 같은 wss:// 주소)
NEXT_PUBLIC_LIVEKIT_URL=

# Supabase → Connect → Transaction pooler (포트 6543) 주소. [YOUR-PASSWORD] 를 DB 비밀번호로 바꾸세요
DATABASE_URL=
